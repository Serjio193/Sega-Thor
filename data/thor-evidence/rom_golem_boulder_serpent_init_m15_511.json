  "routines": [
    {
      "name": "AI_GolemBoulder_Tick",
      "start": "0x0159E2",
      "end": "0x015A8C",
      "size_bytes": 170,
      "description": "Boulder/debris projectile flight physics, collision, and shatter dispatcher. If state +$4 != 0, despawns on anim finish flag +$37:1. If state == 0, integrates horizontal and vertical velocities into subpixel position (+$72/+$76), applies gravity -$C000 to +$56 into Z position +$10. If Z < 0, clamps Z=0 and enters shatter State 2 (anim $E). In flight, executes AABB check vs Ali via 0x00B922 ([-8..+8, -8..+8]) calling Hit Callback 0x015A8C on contact. Checks terrain collision: bit 6 wall collision with condition ($41 & $13 == $12) performs Z-bounce (+10 -= +52); otherwise shatters. Bit 7 entity collision shatters on contact with Ali ($FF19E8)."
    },
    {
      "name": "AI_GolemBoulder_HitCallback",
      "start": "0x015A8C",
      "end": "0x015AE2",
      "size_bytes": 86,
      "description": "Boulder collision hit callback. Enters State 2 (anim $0E). Checks Ali invulnerability (+$38:3) and guard (+$82). If vulnerable, stores attacker pointer, clears guard and +$9D, inflicts 6 HP damage ($8006), knockback mode 3, horizontal knockback -$40000 (-4.0 px), vertical impulse $30000 (+3.0 px), and triggers impact SFX $800207 via 0x00060004."
    },
    {
      "name": "AI_CompositeSerpent_SubModeRouter",
      "start": "0x015AE2",
      "end": "0x015AFE",
      "size_bytes": 28,
      "description": "Composite Serpent/Multi-segment boss sub-mode dispatcher. Reads +$66(a6): 0 -> 0x016294, 1 -> 0x015AFE (9-slot composite constructor), 2 -> 0x015CCA, 3 -> 0x015CB6."
    },
    {
      "name": "AI_CompositeSerpent_InitCompositeSegments",
      "start": "0x015AFE",
      "end": "0x015C4A",
      "size_bytes": 332,
      "description": "Initializes 9 sequential child entity slots in Pool 2 with stride $BC (188 bytes) via CopyParentEntityAttributes (0x00E66E). Configures 4 body segments (anim $3A, facings 3/5), 1 head segment (anim $3C, sub-mode 2, size 16, bounds 8x6x16, extent 4, dx=-32, dy=+40, HP 20, max HP 20, tile $200), and 4 tail/orb segments (anim $2C/$2E/$30/$30, tile $200). Restores root entity pointer, resets sub-mode/facing, sets State $18, anim 4, HP 50, max HP 50, clears +$B0, and jumps to script/entity engine 0x02ED20."
    }
  ],
