  "subroutines": [
    {
      "name": "ScriptEngine_MainTickAndDispatchLoop",
      "start": "0x00F788",
      "end": "0x00F7D0",
      "size_bytes": 72,
      "description": "Checks script disabled flag bit 1 of $FF17B8 (exits if set). Checks delay timer $FF17B6 (decrements and exits if > 0). If camera pan timer $FF17BD != 0, delegates to pan runner at $F894. Otherwise loads script PC a0 from $FF17B2 and enters bytecode interpretation loop: reads opcode byte *(a0)++, indexes 98-entry jump table at $F7D0, calls handler via jsr (a1), writes updated PC to $FF17B2, and repeats until an opcode handler exits."
    },
    {
      "name": "ScriptEngine_CameraPanModeRunner",
      "start": "0x00F894",
      "end": "0x00F8C8",
      "size_bytes": 52,
      "description": "Reads camera pan direction mode from $FF183A, indexes 4-entry mode table at $F8C8, and calls directional displacement updater. Decrements pan timer $FF17BD; upon reaching 0, clears camera lock flag $FF1982, and clears player movement suppression flags $FF19EC and $FF1A12."
    },
    {
      "name": "ScriptEngine_DirectionalCameraPanHandlers",
      "start": "0x00F8D0",
      "end": "0x00F91C",
      "size_bytes": 76,
      "description": "Applies subpixel velocity from $FF183C to camera coordinates: Mode 0 (Up): camera Y ($FF1A5E) -= speed << 16. Mode 1 (Right): camera X ($FF1A5A) += speed << 16. Mode 2 (Down): camera Y ($FF1A5E) += speed << 16. Mode 3 (Left): camera X ($FF1A5A) -= speed << 16."
    },
    {
      "name": "ScriptEngine_Opcode00_FrameYieldExit",
      "start": "0x00F91C",
      "end": "0x00F920",
      "size_bytes": 4,
      "description": "Opcode 0x00 implementation: executes addq.l #4, sp; rts, cleanly exiting interpreter loop."
    }
  ],
