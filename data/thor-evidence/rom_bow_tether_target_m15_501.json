  },
  "routines": [
    {
      "name": "AI_BowSpirit_VineTetherPhysics",
      "start": "0x014242",
      "end": "0x0143C8",
      "size_bytes": 390,
      "description": "Bow Spirit 4-node vine tether physics engine. Decrements 4 node timers at $FF19AC, $FF19B2, $FF19B8, $FF19BE if > 0. Executes 2-pass 3D distance constraint solver via 0x00F160: forward pass from Bow (a6) down through nodes 3, 2, 1, 0, and backward pass from Ali anchor (a4) up through nodes 0, 1, 2, 3 to Bow (a6). Early-exits on Carry Clear (distance satisfied without clamping). Clamps Bow vertical elevation relative to Ali base height."
    },
    {
      "name": "AI_BowSpirit_RoundRobinTargetScanner",
      "start": "0x0143C8",
      "end": "0x014494",
      "size_bytes": 204,
      "description": "Round-robin Pool 2 enemy target scanner and lunge launcher. Advances cursor offset +$aa(a6) by 0xBC (188 bytes) across 17 slots ($FF1CD8..$FF2954). Filters active enemies (+0 > 0, +$38 bit 3 == 0, +$3a bit 0 == 0, special case type $66). Checks 3D Euclidean distance to Ali via 0x00F0EC <= 0x36. On match, projects 3D lunge velocity vector via 0x00F10C (speed $60), computes facing via 0x00E338, sets anim $22, timer 12, substate 3, and returns Carry=1 (success). Returns Carry=0 on fail."
    },
    {
      "name": "AI_BowSpirit_FindNearestPool2Enemy",
      "start": "0x014494",
      "end": "0x014522",
      "size_bytes": 142,
      "description": "Nearest Pool 2 enemy Manhattan distance finder. Scans all 17 slots in Pool 2 ($FF1CD8..$FF2954) relative to Ali anchor +$4e/+$52/+$56(a4). Applies entity filters (active, not friendly/invulnerable bit 3, not target-immune bit 0 unless type $66). Computes 3D Manhattan metric |dx| + |dy| + |dz|. Tracks minimum distance and pointer. Returns Carry=0 (success) with a0=nearest entity, d0=distance, or Carry=1 on none."
    }
  ],
