    "entity_apply_box_force_vector_with_elevation_boost": {
      "address": "0x00DE00",
      "length": 108,
      "notes": "Performs 3D AABB check. If entity Z ($10) != 0, doubles the (d1, d2) displacement force."
    },
    "entity_apply_conveyor_current_force": {
      "address": "0x00DE6C",
      "length": 128,
      "notes": "Checks immunity flags bit 0 and bit 3 at +$3A(a0). Performs 3D AABB check and doubles force when entity Z ($10) != 0."
    }
  },
