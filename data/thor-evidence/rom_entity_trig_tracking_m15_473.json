{
  "milestone": "M15.473",
  "title": "ROM Entity AI Trigonometric Tracking, Smooth Angle Turn-Rate Limiter & 2D Sin/Cos Velocity Projection Engine",
  "range": {
    "start": "0x010594",
    "end": "0x01074A",
