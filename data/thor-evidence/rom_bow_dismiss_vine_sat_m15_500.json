  "routines": [
    {
      "name": "AI_Bow_Dismissal",
      "start": "0x013F22",
      "end": "0x013F5A",
      "size_bytes": 56,
      "instruction_count": 12,
      "description": "Guards +$04(a6)==0 (else branches to 0x0138B8 low-SP blink check). Plays SFX #$00A0039E via 0x00E7FC, clears child slot +$00(+$A6(a6))=0, enters State $10 (+$2A=$1E), clears +$16=0, sets priority +$18=$07A8, and clears +$36 bit 0."
    },
    {
      "name": "AI_Bow_State10_DescendDespawn",
      "start": "0x013F5A",
      "end": "0x013F6E",
      "size_bytes": 20,
      "instruction_count": 5,
      "description": "Clears +$36(a6) bit 1 and waits for +$37(a6) bit 1; when set clears +$00(a6)=0 to despawn Bow."
    },
    {
      "name": "AI_Bow_State02_ReturnAndSettle",
      "start": "0x013F6E",
      "end": "0x013FDC",
      "size_bytes": 110,
      "instruction_count": 24,
      "description": "Waits for +$37(a6) bit 1, settles Bow into State 0 (+$2A=0, +$9E=0, +$16=1, clears +$38 bit 2), initializes $FF1C1C vine SAT sub-entity (+$00=$FFFF, +$22=$00014084, +$18=(parent_18 & $8000)|$07A8, anchor +$4E/+$52/+$56 from parent +$08/+$0C/+$10, cross-links +$A6), and calls 0x013FFC."
    },
    {
      "name": "AI_Bow_InterpolateVineChainNodes",
      "start": "0x013FDC",
      "end": "0x014084",
      "size_bytes": 168,
      "instruction_count": 55,
      "description": "0x013FDC computes (head - anchor) into 0x00E338 to face Bow away from anchor (+$16). 0x013FFC updates $FF1C1C sort Y = min(head_y-2, anchor_y) and steps 4 nodes (1/5..4/5) from anchor (+$4E/+$52/+$56) to head (+$08/+$0C/+$10) using 12.4 fixed-point divs #5 with per-step asr.w #4 -> store -> asl.w #4 quantization into $FF19A8..$FF19BF (4x 6-byte XYZ).",
      "sub_entry_points": {
        "update_facing_from_anchor": "0x013FDC",
        "interpolate_4_vine_nodes": "0x013FFC",
        "step_and_quantize_node": "0x01406A"
      }
    },
    {
      "name": "AI_Bow_RenderVineSubEntitySAT",
      "start": "0x014084",
      "end": "0x014200",
      "size_bytes": 380,
      "instruction_count": 92,
      "description": "Checks parent +$00==$001E (else frees self +$0=0); skips on parent +$36 bit 1 blink. Emits up to 6 SAT entries to $FF13CC+$FF188C (clip d5<80, X in [$68,$1C0), Y in [$70,$160)): 4 vine nodes walking backward $FF19BA->$FF19A8 (tile +$18, size 0x0000, +$7C/+$7C-z), Bow ground shadow at $FF1AA4 (tile $0549, size $0400, +$78/+$7D), and root anchor at $FF1C1C (tile +$18+9, size $0E00, +$71/+$74-z), committing $FF188C/$FF188A.",
      "sub_entry_points": {
        "render_callback_entry": "0x014084",
        "project_vine_node": "0x014126",
        "project_root_anchor": "0x01415C",
        "project_spirit_shadow": "0x014192",
        "clip_and_emit_sat_entry": "0x0141CA"
      }
    },
    {
      "name": "AI_Bow_StepAndClampVelocityByLeash",
      "start": "0x014200",
      "end": "0x014242",
      "size_bytes": 66,
      "instruction_count": 18,
      "description": "Saves +$08/+$0C(a6) on stack, adds +$72/+$76(a6) into +$08/+$0C, calls leash clamp helper 0x014242, computes clamped delta (new_pos - old_pos) into +$72/+$76(a6), and restores original +$08/+$0C(a6)."
    }
  ],
