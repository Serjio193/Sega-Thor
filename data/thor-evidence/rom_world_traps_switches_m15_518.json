  },
  "routines": [
    {
      "name": "Object_MovingBridge_DustStreamer",
      "start": "0x016A64",
      "end": "0x016ADE",
      "size_bytes": 122,
      "description": "Moving bridge particle / dust streamer. Mode +$9E: 0 = X-axis motion with (PRNG << 1) Z-height jitter, steps +$8 by +$4E, despawns (+0=0) when crossing +$A0 target bound; 1 = Y-axis motion with (PRNG << 2) Z-height jitter, steps +$C by +$52, despawns when crossing +$A0."
    },
    {
      "name": "Object_FallingStalactite_Trap",
      "start": "0x016ADE",
      "end": "0x016BD0",
      "size_bytes": 242,
      "description": "Falling stalactite ceiling trap. Sub-state +$9E: 0 = ceiling initialization (z=0xF0=240), PRNG wait timer (d0 & $3F) + 4 (or immediate drop timer=1, vz=-$18 if +$A0!=0), sets +$36:1 -> State 1; 1 = viewport culling 0x00E5AE(4) + timer countdown -> random anim 0 or 4 via $FF1971:0 -> State 2; 2 = falling ballistics with gravity -$C000, AABB collision check 0x00B852 [-1..+1, -1..+1] vs Ali (shatters on non-flying target +$38:2 == 0), floor collision (z < 0) clamps z=1, advances anim +2 -> State 3; 3 = shatter animation: on anim finished +$37:1, respawns to State 0 if +$A0==0, else despawns (+0=0)."
    },
    {
      "name": "Object_FloorPressureSwitch",
      "start": "0x016BD0",
      "end": "0x016C5C",
      "size_bytes": 140,
      "description": "Floor pressure switch. Sets height z = $FFF0 (-16). Mode +$9E: 0 = momentary switch, 1 = one-shot latched switch. Performs AABB check vs Ali 0x00B852 [-6..+10, +6..+22]. Momentary: sets/clears persistent bit via 0x018030 and updates anim 2 (pressed) / 0 (released). One-shot latch: checks persistent bit; if unpressed, detects player contact, sets bit, plays latch SFX #$900229 via 0x00E7FC, and permanently locks anim 2."
    },
    {
      "name": "Object_HitToggleCrystalSwitch",
      "start": "0x016C5C",
      "end": "0x016CBE",
      "size_bytes": 98,
      "description": "Hit-toggle crystal switch. Retrieves persistent bit address/index via 0x018030. Manages 10-frame invulnerability cooldown timer +$2 (clearing +$82 on expiration). On weapon hit (+$86 != 0): clears damage and flinch, sets invulnerability guard +$82=$FF, resets cooldown +$2=10, toggles persistent bit via bchg.b, plays chime SFX #$900229, and updates anim: 2 if bit set, 0 if clear."
    }
  ],
