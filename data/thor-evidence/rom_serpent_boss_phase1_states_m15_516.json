{
  "milestone": "M15.516",
  "title": "ROM Serpent Boss Phase 1 States 0x00..0x18 (Hover, Bounds-Clamped Glide, Dive Leap, Ground Slam Tremor & 4-Shot Fan Barrage)",
  "range": {
    "start": "0x0164E2",
    "end": "0x016764",
    "size_bytes": 642
  },
  "routines": [
    {
      "name": "AI_SerpentBoss_State00_HoverWait",
      "start": "0x0164E2",
      "end": "0x0164F2",
      "size_bytes": 16,
      "description": "State $00 Idle/Hover Wait. Calls 0x016764 (d5=0); decrements countdown timer +$2; when timer <= 0, branches to pattern action 0x016862."
    },
    {
      "name": "AI_SerpentBoss_State16_DeathGravityFall",
      "start": "0x0164F2",
      "end": "0x01651C",
      "size_bytes": 42,
      "description": "State $16 Death Gravity Fall. Applies gravity -$C000 to +$56 into height +$10; on ground impact (Z <= 0), clamps Z=0, calls cleanup 0x00F740 and effect 0x00E96C mode 12."
    },
    {
      "name": "AI_SerpentBoss_State18_SettleWait",
      "start": "0x01651C",
      "end": "0x01652E",
      "size_bytes": 18,
      "description": "State $18 Settle Wait. Calls 0x016764 (d5=0); when event flag +$F3:1 is set, transitions to pattern sequencer 0x01685A."
    },
    {
      "name": "AI_SerpentBoss_State02_ArenaGlide",
      "start": "0x01652E",
      "end": "0x01656A",
      "size_bytes": 60,
      "description": "State $02 Arena Glide & Footstep SFX. Calls 0x016764 (d5=-20), applies X-velocity (+$A2 << 16) clamped to [0x60..0x1A0] via 0x01656A. Increments step timer +$2; every 8th frame plays SFX #$70035E via 0x00E7FC. On +$F3:1 -> transitions to 0x01685A."
    },
    {
      "name": "AI_SerpentBoss_Helper_ClampXPosition",
      "start": "0x01656A",
      "end": "0x01658A",
      "size_bytes": 32,
      "description": "X-velocity clamping helper. Clamps arena X movement to bounds [0x60..0x1A0] (96..416 px). If moving right (d1 >= 0) and pos > 0x1A0, sets d1=0. If moving left (d1 < 0) and pos < 0x60, sets d1=0. Accumulates into +$72(a6)."
    },
    {
      "name": "AI_SerpentBoss_States04_06_08_0A_WindupArmWait",
      "start": "0x01658A",
      "end": "0x0165E2",
      "size_bytes": 88,
      "description": "Attack Windup & Arm Wait states. State $04: on +$F3:1 -> State 6, timer +$2=20, anim 0x016A46($2A). State $06: timer +$2 countdown -> State 8, anim 0x016A46($E). State $08: on +$F3:1 -> 0x01685A. State $0A: waits for child arm slot $FF2084 +$4 == 0 -> 0x016862."
    },
    {
      "name": "AI_SerpentBoss_States0C_0E_10_DiveLeapGroundSlam",
      "start": "0x0165E2",
      "end": "0x0166D2",
      "size_bytes": 240,
      "description": "Dive Leap toward Ali & Ground Slam. State $0C: on +$F3:1, computes trajectory vector (ali_pos - boss_pos) / 42 (divs #$2A) into +$4E/+$52, sets vertical launch velocity +$56=$100000, enters State $0E, anim 0x016A46($26). State $0E: while +$EC > 0, applies gravity -$C000; while Z > 0x30, integrates velocities (Y + clamped X); on landing (Z <= 0x30), clamps Z=0x30, clears +$56=0, enters State $10, anim 0x016A46($22). State $10: when +$EC == 4, triggers screen shake $FF17C4=0x0C, plays impact SFX #$90021C and rumble SFX #$80035D. On +$F3:1 -> 0x01685A."
    },
    {
      "name": "AI_SerpentBoss_States12_14_FanBarrage",
      "start": "0x0166D2",
      "end": "0x016764",
      "size_bytes": 146,
      "description": "Fan Barrage Spawner & Exit. State $12: on +$F3:1 -> State $14, +$2A=2, anim 0x016A46($2A). State $14: at anim frame +$30 == 8, checks burst counter +$A0: if > 0, increments +$2E, decrements +$A0, and on even count spawns projectile via 0x0167BE using 4-byte angle table at 0x016734 ([0xB5, 0xCB, 0x9F, 0xE1]) at speed $30000; if +$A0 == 0, spawns aimed/center projectile (angle $C0, speed $40000). On anim finish +$37:1 -> resets to State 8, +$2A=0, anim 0x016A46($E)."
    }
  ],
