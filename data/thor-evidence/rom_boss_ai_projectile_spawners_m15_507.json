  "routines": [
    {
      "name": "AI_Boss_SpawnFeatherSporeProjectile",
      "start": "0x015136",
      "end": "0x0151FC",
      "size_bytes": 198,
      "description": "Spawns single feather/spore projectile (type $24) into Pool 2 via 0x00DA2A and 0x008D06. Sets tile $200, 8px bounds extents, size 8, flying/invulnerable flags +$38:3/:2, sorting layer 2, anim 6, State $0C. Launches upward with vz = -$50000. Indexes 3-entry 8B table at 0x0151FC by (parent_facing - 1) * 8 to obtain (dx, dy, vx_hi, vy_hi), adding to parent XY position and velocity. Sets z = parent_z + 0x10 and calls 0x009D00."
    },
    {
      "name": "AI_Boss_Spawn3WayFireballSpread",
      "start": "0x015214",
      "end": "0x0152FE",
      "size_bytes": 234,
      "description": "Spawns 3-way spread fireball projectiles (type $24) with angle offsets d6 = 0 (center), +$1C (right), -$1C (left). Allocates slot via 0x00DA2A, sets tile $200, bounds 5px, height 8px, anim $14, State $12. Indexes 3-entry 8B table at 0x0152FE for (dx, dy, base_angle), evaluates sin/cos of (base_angle + d6) from ROM $5D706 scaled by $600 into +$4E/+$52. Sets vz = -$C000 and calls 0x009D00."
    }
  ],
