  "routines": [
    {
      "name": "AI_World_SpiritCrystalOrbSwitch",
      "start": "0x016CBE",
      "end": "0x016D5C",
      "size_bytes": 158,
      "instruction_count": 41,
      "description": "Spirit Crystal Orb Switch: sub-mode 0 initializes z=+$8C, checks persistent bit via 0x018030 (if set, anim 2, solid +$38:3, +$3C:1; else anim 0); sub-mode != 0 enforces 10-frame cooldown on +$82, incoming damage at +$86: if bit 13 set (spirit weapon), plays chime SFX #$9003A1 via 0x00E7FC, sets persistent bit via 0x018030, sets anim 2, +$3C:1, locks cooldown +$82=$FF; else plays clink SFX #$900238."
    },
    {
      "name": "AI_World_BreakableWallBlock",
      "start": "0x016D5C",
      "end": "0x016DCE",
      "size_bytes": 114,
      "instruction_count": 31,
      "description": "Breakable Barrier / Wall Block: sub-mode 0 initializes HP +$88 and +$8A from parameter +$A0; sub-mode != 0 enforces 6-frame cooldown on +$82, incoming damage at +$86: if bit 13 set (spirit weapon), subtracts lower 12-bit damage from HP +$8A, if HP<=0 sets persistent bit via 0x018030, raises z+=16, triggers shatter debris via 0x00E96C(1); else plays clink SFX #$900238."
    },
    {
      "name": "AI_World_FloorSpikeSawHazard",
      "start": "0x016DCE",
      "end": "0x016EBC",
      "size_bytes": 238,
      "instruction_count": 60,
      "description": "Floor Spike / Saw Hazard & Blinking Despawn: sub-mode 0: 52-frame sound timer +$AA plays blade buzz SFX #$600262 via 0x00E7E8; performs AABB collision test vs Ali via 0x00B922 [-14..+14, -8..+8, 0..40]; on contact checks Ali guard +$38:3, invulnerability +$82, hitstun +$83<2; inflicts damage $200F ($A00F if airborne), directional knockback via 0x00E338/0x00E2D4 ($400/$3C0 speeds), vz=+$00020000, hitstun +$83=10, impale SFX #$8004D9; sub-mode != 0: toggles visibility bit +$36:1 for 15 frames +$2, then despawns entity +$0=0 and sets persistent bit via 0x018030."
    }
  ],
