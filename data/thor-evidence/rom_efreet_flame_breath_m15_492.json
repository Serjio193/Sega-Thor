  "routines": [
    {
      "name": "AI_Efreet_InitFlameBreathParticlesAndAngle",
      "start": "0x012C4E",
      "end": "0x012CDC",
      "size_bytes": 142,
      "code_bytes": 138,
      "instruction_count": 35,
      "description": "Marks all 7 particle slots at (a0)+$04 (stride $14) free via st.b $0(a1). Polls latched D-pad bits on $FF19A3 in priority Up(0)/Down(1)/Right(3)/Left(2) to latch fixed facing +$16, +$AA=0, and angle +$AB in {$40,$C0,$00,$80}. If no direction bit is set, indexes 0x012C92[+$16] ([0x20,0xE0,0xA0,0x60]), sets +$AA=$FF (sweep mode), and writes start angle to +$AB.",
      "table_bytes": 4,
      "embedded_table": "0x012C92..0x012C96"
    },
    {
      "name": "AI_Efreet_UpdateFlameBreathParticles",
      "start": "0x012CDC",
      "end": "0x012DAE",
      "size_bytes": 210,
      "code_bytes": 164,
      "instruction_count": 47,
      "description": "Iterates 7 particle slots at +$A6(a6)+$04 (stride $14), skipping +$00 != 0. Decrements +$12 timer; on < 0 increments +$13 index across 11-entry table 0x012D80 (u16 tile, u16 duration) terminated by $FFFF (marking slot free with st.b $0(a1) and skipping tick). Integrates +$02 += +$0A, +$0E -= $4000, +$06 += +$0E, and scans 0x00B922 (d0=$F0, box [px-8..px+8, py-8..py+8, 4..20]) calling 0x012DAE if +$38(a0) bit 3 is clear and +$82(a0) == 0.",
      "table_bytes": 46,
      "embedded_table": "0x012D80..0x012DAE"
    },
    {
      "name": "AI_Efreet_IgniteEnemyOnFlameHit",
      "start": "0x012DAE",
      "end": "0x012DFA",
      "size_bytes": 76,
      "code_bytes": 76,
      "instruction_count": 19,
      "description": "Applies flame breath impact to target a0: sets attacker link +$7E(a0)=a6, clears +$9D(a0)=0, plays SFX #$00700345 via 0x00E7FC, copies +$16(a6) to +$84(a0), projects (0x300, 0x300) velocity via 0x00E2D4 into +$4E/+$52(a0), sets upward velocity +$56(a0)=$00020000, and writes fire damage word +$86(a0) = $A004 + (($FF0DB7 + 1) >> 2)."
    },
    {
      "name": "AI_Efreet_SpawnFlameParticle",
      "start": "0x012DFA",
      "end": "0x012EA8",
      "size_bytes": 174,
      "code_bytes": 166,
      "instruction_count": 48,
      "description": "Finds first free particle slot (+$00(a1) != 0) or returns Carry set if all 7 slots are active. Initializes +$00=$0063, +$12=3, +$13=0; if +$AA != 0 advances +$AB by +5 (mod 256) before computing velocities (+cos*0x700, -sin*0x700 + $20000) via $05D706; initializes +$02/+$06 from 4x2-byte signed offset table 0x012EA0[+$16] << 16 and returns Carry clear.",
      "table_bytes": 8,
      "embedded_table": "0x012EA0..0x012EA8"
    },
    {
      "name": "AI_Efreet_ExportFlameVertexBuffer",
      "start": "0x012EA8",
      "end": "0x012F1E",
      "size_bytes": 118,
      "code_bytes": 118,
      "instruction_count": 32,
      "description": "Scans all 7 particle slots, appending 3-byte tuples (+$01 tile, dx, +$07 dy) into $FF19A9.. (negating 8-bit dx = +$03 when +$16(a6) == 3 Left). If 0 active particles clears +$06(a6)=0; else writes header (count-1) | ($80 if +$16!=2) to $FF19A8, sets +$06(a6)=$1A, +$5E(a6)=0, +$5A(a6)=$07A8, +$62(a6)=$FF19A8."
    }
  ],
