  "routines": [
    {
      "name": "AI_WorldObject_DestructibleEnemyObject",
      "start": "0x017E28",
      "end": "0x017FF2",
      "size_bytes": 458,
      "instruction_count": 107,
      "description": "Interactive/destructible object & enemy controller with relative jump table at 0x017EE6 (states 0/2/4/6/8 via +$4). Clears +$16/+$66 on first tick, calls 0x00E682. On incoming damage +$86 != 0: bit 13 sets +$39:3 and plays SFX #$8004D9; subtracts defense +$92 from 12-bit damage (clamped >= 1) and deducts from HP +$8A. On 0 HP: enters Death state 2 (anim 2 via 0x008EF8, timer +$2 = 16, invuln +$38:3, SFX #$900232); else enters Flinch state 8 (anim 10 via 0x008EF8). Applies gravity -$C000 when z > 0. Action selector 0x017EF0 checks target distance 0x00E398 < 48 -> State 6 (anim 6), else screen shake $FF17C4 != 0 or PRNG 0x00E268 < 0x1A00 -> State 4 (anim 4), else State 0 (timer +$2 = 4, anim 0). State 2 blinks +$36:1 for 16 frames then calls loot drop 0x00F476 (table 0x017F6C) and despawns (+$0 = 0). State 4 waits for +$37:1. State 6 plays SFX #$800202 on frames 12/20 and runs hitbox check 0x00BCE2 with callback 0x017FC0 (0x00BEBA, +$84 = 2, neg.l +$52). State 8 holds +$36:6 until +$37:1 then clears +$36:6 and +$39:3."
    },
    {
      "name": "PersistentFlag_SetBit",
      "start": "0x017FF2",
      "end": "0x018030",
      "size_bytes": 62,
      "instruction_count": 19,
      "description": "Core persistent flag bit setter. Maps bank selector +$A2(a0) (1 -> $FF0DBC, 2 -> $FF0E1C, 3 -> $FF0E2C; 0 or >= 4 -> no-op) and bit index +$A4(a0) (byte offset = +$A4 >> 3, bit = +$A4 & 7) to execute bset.b d1, (a1, d0.w)."
    },
    {
      "name": "PersistentFlag_ResolveBit",
      "start": "0x018030",
      "end": "0x018072",
      "size_bytes": 66,
      "instruction_count": 20,
      "description": "Core persistent flag bit resolver. Maps bank selector +$A2(a6) (1 -> $FF0DBC, 2 -> $FF0E1C, 3 -> $FF0E2C) and bit index +$A4(a6) to return byte pointer in a0 (base + (+$A4 >> 3)), bit index in d0 (+$A4 & 7), and Carry clear (C = 0). For bank 0 or >= 4, returns Carry set (C = 1)."
    }
  ],
