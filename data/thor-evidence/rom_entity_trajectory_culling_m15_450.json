{
  "routine": "rom_entity_trajectory_culling",
  "description": "ROM Entity Trajectory Gravity Integration, Viewport AABB Culling & 188-Byte Slot Cloner",
  "start_address": "0x00E502",
  "end_address": "0x00E6BA",
  "byte_count": 440,
  "instruction_count": 122,
  "subroutines": {
    "entity_integrate_trajectory_gravity_fall": {
      "start": "0x00E502",
      "end": "0x00E5AE",
      "callers_count": 22,
      "notes": "Integrates fixed-point gravity (subi.l #$c000, $56(a6)), updates elevation +$10(a6). If negative, handles ground landing: zeroes elevation and velocity, sets bit 2 of +$39, sets recovery timer +$9A to 15 frames, optionally triggers landing shockwave ($800270). If airborne, updates displacements (+$72, +$76) and tests collision."
    },
    "entity_viewport_culling_test_screen": {
      "start": "0x00E5AE",
      "end": "0x00E60E",
      "callers_count": 35,
      "notes": "Tests entity screen pos (x, y - elev) against camera viewport [320 x 224] plus margin d7. Returns CCR carry clear if visible, carry set if culled."
    },
    "entity_viewport_culling_test_shadow": {
      "start": "0x00E610",
      "end": "0x00E66C",
      "callers_count": 18,
      "notes": "Tests entity ground shadow pos (x, y) against camera viewport [320 x 224] plus margin d7 without elevation subtraction."
    },
    "entity_slot_copy_188b": {
      "start": "0x00E66E",
      "end": "0x00E680",
      "callers_count": 12,
      "notes": "Copies 94 words (188 bytes / $BC) from (a4)+ to (a6)+ via dbra d0, copying full entity record."
    },
    "entity_invulnerability_cooldown_tick": {
      "start": "0x00E682",
      "end": "0x00E6BA",
      "callers_count": 16,
      "notes": "Clears invulnerability bit 6 of +$36(a6). Checks flash timer +$9D; if < 20, sets bit 6 to blink. Decrements hitstun cooldown +$82; if still active, aborts caller execution via addq.l #4, a7."
    }
  },
