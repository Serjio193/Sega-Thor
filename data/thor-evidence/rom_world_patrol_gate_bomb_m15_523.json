  "routines": [
    {
      "name": "AI_World_PatrollingPacingTrap",
      "start": "0x01778C",
      "end": "0x0178EA",
      "size_bytes": 350,
      "instruction_count": 93,
      "description": "Patrolling / Pacing Bridge Trap: sub-mode 0 saves home coordinates to +$A8/+$AA and height z=+$8C; sub-mode 1 scans boundary tiles via 0x00C1CE using 4x4-byte signed vector table at 0x01783E, computes directional velocity via 0x00E2D4 from speed +$A0, sets timer +$2=+$9E, anim 2, plays trap start SFX #$800399 via 0x00E7E8; sub-mode 2 animates via 0x00BC8E, accelerates then decelerates past midpoint +$9E/2 while integrating position deltas into +$72/+$76, flips direction bit +$17:1 at timer expire, sets anim 4, enters sub-mode 3; sub-mode 3 homes back to +$A8/+$AA via 0x00E45E, on arrival flips +$17:1, anim 0, returns to sub-mode 1."
    },
    {
      "name": "AI_World_PersistentGateHiddenBridge",
      "start": "0x0178EA",
      "end": "0x0179D4",
      "size_bytes": 234,
      "instruction_count": 59,
      "description": "Persistent Gate & Hidden Bridge Controller: init sets +$66=1, anim 2*(+$8C), raises z+=1; dispatches via 3-entry jump table at 0x017920: Entry 0 queries persistent flag via 0x018030 to toggle visibility +$36:1, solid collision +$38:2, and elevation z=10000 vs 0, playing gate rumble SFX #$B00385 via $60004 on elevation change; Entry 1 waits 10 frames then checks living enemies 0x0101EC <= +$A0 to trigger gate unlock callback 0x017D06 with chime SFX #$A00228; Entry 2 counts 15-frame delay on +$2 before triggering 0x017D06."
    },
    {
      "name": "AI_World_BombDestructibleBarrier",
      "start": "0x0179D4",
      "end": "0x017A96",
      "size_bytes": 194,
      "instruction_count": 52,
      "description": "Bomb-Destructible Barrier: sub-mode 0 initializes via 0x0178F2, if +$9E!=0 enters sub-mode 3 with flipped visibility +$36:1; sub-modes 1 and 3 on hit +$86!=0 check attacker ptr +$7E==$FF1AA4 and entity type==$1E (Bomb): if bomb, invokes persistent callback 0x017FF2, plays explosion SFX #$900202 via 0x00E7FC, transitions to destruction anim (sub-mode 2, despawns on anim done +$37:1) or instantly despawns +$0=0; if non-bomb, plays deflection clink SFX #$900238."
    }
  ],
