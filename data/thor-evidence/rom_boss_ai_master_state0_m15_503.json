  "routines": [
    {
      "name": "AI_BowSpirit_SpawnInit",
      "start": "0x0147E0",
      "end": "0x014848",
      "size_bytes": 104,
      "description": "Bow Spirit (0x1E) spawn initializer. Configures entity type $1E, VRAM tile $4F8, HP 100, SP 10, position, facing, sprite $9D00, state 2, anim $14, flying bit 2 of +$38, clears $FF1C1C leash flag, and plays summon SFX $80037E via $E7FC."
    },
    {
      "name": "AI_Boss_MasterTick_DamageDeathHandler",
      "start": "0x014848",
      "end": "0x014914",
      "size_bytes": 204,
      "description": "Boss/Flying Enemy AI master tick, damage processing, and death handler. Ticks helpers $E682/$E36E, tests hitstun $A2 and flag $B4. Processes incoming damage from $86 (ignoring if bit 13 set), increments hit counter $B6, sets flinch anim $10 and state $0E, integrates knockback, subtracts 12-bit damage from HP $8A, plays hit SFX $A00250. If HP reaches 0: enters death state $1A, sets anim $18, invulnerable bit 3, flag $A2, spawns death particle $7F via $E90E, sets lock $FF1983, and calls $DAE6. Dispatches to 14-entry relative state jump table at 0x014914."
    },
    {
      "name": "AI_Boss_State00_ActionSelector",
      "start": "0x014932",
      "end": "0x014A5C",
      "size_bytes": 298,
      "description": "State 0x00 PRNG action selector. Evaluates PRNG word d0 against thresholds $2000, $6000, $9000 (or if cutscene lock $FF1987 is active). Default action calculates midpoint between fixed origin (0x100, 0x140) and Player Ali ($FF19E8) with [-16..+15] PRNG jitter. Applies Chebyshev distance to select fixed speed: $20000 (>32px), $10000 (17..32px), or $8000 (<=16px), sets timer 10, and transitions to State 0x04 (Wander Stepper)."
    },
    {
      "name": "AI_Boss_State04_WanderStep",
      "start": "0x014A5C",
      "end": "0x014A72",
      "size_bytes": 22,
      "description": "State 0x04 wander stepper. Invokes kinematic steering helper $150A0 toward wander target coordinates +$A6/+$AA. Decrements wander timer +$2(a6); when timer reaches 0, transitions directly back to State 0x00 (0x014932) to select next action."
    }
  ],
