  "routines": [
    {
      "name": "AI_World_RoomDoorPortalWarpTrigger",
      "start": "0x017A96",
      "end": "0x017CA6",
      "size_bytes": 528,
      "instruction_count": 127,
      "description": "Room Door, Portal & Warp Trigger: type!=$7C tests AABB contact vs Ali via 0x00B922 [-3..+3, -1..+1, 0..1000]; if target room +$4E != $FF0E40 sets transition flags $FF17BB/$FF17BF, plays SFX #$800230 via $60004, executes special room $90B check via 0x00C2EC, jumps to 0x00CA24; same-room door teleports Ali to (+$52, +$54) via 0x009D00; vortex portal type==$7C tests cutscene locks $FF1985/$FF1987, filters Ali excluded states, exerts suction via 0x00E45E with thresholds 1/24/40/56 into warp state $6E with target (+$AE, +$B0, +$B2), anim $78, SFX #$800230."
    },
    {
      "name": "AI_World_SpiritLockPersistentDespawner",
      "start": "0x017CA6",
      "end": "0x017D12",
      "size_bytes": 108,
      "instruction_count": 28,
      "description": "Spirit/Key Lock Trigger & Persistent Despawner: 0x017CA6 checks +$4C:7 and $FF1985 for visibility toggle, evaluates spirit sparkle $FF0DBA:1 contact via 0x00B922 [-10..+10, -6..+6, 0..4]: on contact with type $16 (Spirit Sparkle) reveals lock with anim 2 and SFX #$80022F via 0x00E7FC; 0x017D06 clears +$0 and invokes persistent callback 0x017FF2."
    },
    {
      "name": "AI_World_TreasureChest",
      "start": "0x017D12",
      "end": "0x017E28",
      "size_bytes": 278,
      "instruction_count": 70,
      "description": "Treasure Chest: init sets +$66=$FF, height z=+$A0; auto-open bit 7 sets state 0x0A, anim+=2, timer=1; ballistic gravity -$C000 applies to z>0, floor impact z<0 triggers bounce vz=+$30000 with SFX #$400376 via 0x00E7FC; hit-to-open on damage +$86!=0 advances state 1, timer 2, anim+=2, plays open SFX #$900232 via 0x00E7FC; timer expiry invokes persistent callback 0x017FF2 (if +$9E!=0), spawns loot item +$8C via 0x00F53C, applies parameters +$A2/+$A4, and despawns chest."
    }
  ],
