    },
    {
      "opcode": "0x01",
      "name": "ScriptOp_SpawnScriptEntity",
      "start": "0x00FCCE",
      "end": "0x00FD86",
      "size_bytes": 184,
      "description": "Checks quest state via $0101EC against threshold $FF17B7 (aborts script if >= threshold). Allocates entity slot via $DA2A and verifies scene entity count limit $01027C. Reads spawn mode d7.b and entity type d1.w (stored to +$00), runs constructor $8D06, randomizes facing 0..3 via $E268, stores parameter +$96, evaluates spatial position via table at $FD86, sets initial & max HP +$88/+$8A, drop item +$8C, visual flag +$66, runs animation setup $9D00, and starts entity AI from table $DF54 for type >= $16.",
      "constants": {
        "ai_jump_table": "0x00DF54",
        "ai_min_type": 22
      }
    }
