      "name": "ScriptOp_SetLoopCounter",
      "start": "0x00FC94",
      "end": "0x00FCA6",
      "size_bytes": 18,
      "description": "Sets loop counter indexed by (a0)+ at $FF1826 to immediate 16-bit value (a0)+."
    },
    {
      "opcode": "0x08",
      "name": "ScriptOp_WaitFramesSleep",
      "start": "0x00FCA6",
      "end": "0x00FCB8",
      "size_bytes": 18,
      "description": "Sets script frame delay counter $FF17B6 = (a0)+, writes script PC to $FF17B2, and branches to $F91C yielding current frame execution.",
      "constants": {
        "delay_timer": "0xFF17B6"
      }
    },
    {
