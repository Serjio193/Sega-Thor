  "routines": [
    {
      "name": "AI_SpiritOrb_State0_ElementalMediumAndCatalystScan",
      "start": "0x01171C",
      "end": "0x011810",
      "size_bytes": 244,
      "instruction_count": 69,
      "description": "State 0 handler: checks cancel/force-summon flag $FF1990; decays 32-bit Z-elevation +$10(a6) by $18000 clamped >= 0; if airborne checks +$40|+$41 bit 6 (and bit 3 -> despawn at 0x0119C8); probes self bit 1 of +$39(a6) -> spirit 0, water/medium $FF17C2 <= 3 with +$6F bit 5, and shadow/medium $FF17C3 <= 3 with +$6F bit 6; otherwise runs entity AABB scan 0x00B922 (d0.b=$FC mask skipping slots 0..1, box x[-12,+12], y[-10,+10], z[0,+24]), handling Torch $0064 (+$02(a0)=1), Crystal $00B4 (+$A6(a0)=$FF), +$39(a0) bit 3 -> spirit 1, and +$3C(a0) bits 0..3 -> spirits 0..3."
    },
    {
      "name": "AI_SpiritOrb_TransitionToState1Or2",
      "start": "0x011810",
      "end": "0x011866",
      "size_bytes": 86,
      "instruction_count": 20,
      "description": "Entry 0x011810 stores d0 into $FF19A6; entry 0x011818 checks unlocked spirit bit in $FF0D7A and inhibit bit 0 of $FF16F1, falling back to State 2 (0x011832) if locked/inhibited else State 1. Clears velocities +$4E/+$52, writes +$04=state, +$2A=2*state, adds 12 ($0C) to +$10.w, clears timer +$02, sets bit 3 on +$36, plays SFX #$8004D2 via 0x00E7FC, and tail-jumps to 0x0115C8."
    },
    {
      "name": "AI_SpiritOrb_ScanItemCatalysts",
      "start": "0x011866",
      "end": "0x011938",
      "size_bytes": 210,
      "instruction_count": 57,
      "description": "Scans FX/item pool via 0x00B9EC (box x[-4,+4], y[-4,+4], z=0) for Type $0008 items. If $FF16F1 bit 0 is set, rebounds to State 2 (0x011832). When corresponding bit 0..3 of $FF0D7A is unlocked, matches direct catalysts ($12..$15 -> spirits 0..3) or transmutes subtypes $1A->$21 (spirit 0), $1B->$05 with +$52(a0)=$14 (spirit 1), $1C->$11 (spirit 2), $1D->$2A and $27->$26 (spirit 3), setting +$22(a0)=$1E and clearing bit 1 of +$36(a0) before transitioning via 0x011810."
    },
    {
      "name": "AI_SpiritOrb_IntegrateAndUpdateTrail",
      "start": "0x011938",
      "end": "0x0119CE",
      "size_bytes": 150,
      "instruction_count": 46,
      "description": "Calls 0x00E36E, integrates +$4E/+$52 into +$72/+$76, checks viewport culling via 0x00E5AE (margin $10; off-screen despawns via 0x0119C8), decrements trail cooldown +$AC(a6) to allocate one of 6 trail slots +$A6..+$AB(a6) every 3 frames (value 1 with alternating bit 7 via +$AD(a6) ^= 1, cooldown reload 2), and loops over all 6 slots calling 0x0119EC to emit $FF19A9.. vertex data with header 0x80|(count-1) at $FF19A8, +$06=$16, +$62=$FF19A8 (or +$06=0 when empty)."
    },
    {
      "name": "Tilemap_SampleLowNibbleAttribute",
      "start": "0x0119CE",
      "end": "0x0119EC",
      "size_bytes": 30,
      "instruction_count": 11,
      "description": "Computes byte offset d4 = ((y >> 3) << +$08(a0)) + (x >> 3) using arithmetic shifts on (d1.w, d2.w), reads byte at (a1, d4.w) where a1 = +$00(a0), and returns the low nibble (d3 & $0F)."
    },
    {
      "name": "AI_SpiritOrb_EmitTrailParticleVertex",
      "start": "0x0119EC",
      "end": "0x011A4C",
      "size_bytes": 96,
      "instruction_count": 31,
      "code_end": "0x011A3A",
      "code_size_bytes": 78,
      "table_start": "0x011A3A",
      "table_end": "0x011A4C",
      "table_size_bytes": 18,
      "description": "Emits 3-byte (tile_id, dx, dy) trail particle vertex rotated by 4-way facing +$66(a6) with -12 Y sprite anchor offset, reading tile_id from embedded 18-byte SpiritOrbTrailTileTable at 0x011A3A..0x011A4C, lateral jitter +1 (bit 7 clear) or -2 (bit 7 set), and radial distance 3*age+12. When age >= 18 ($12), writes $FF to (a0) and decrements d4 so caller's addq.b #1 wraps slot $FF -> $00."
    }
  ],
