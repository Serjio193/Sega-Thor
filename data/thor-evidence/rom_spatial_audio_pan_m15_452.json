    "spatial_sound_entity_flag_set": {
      "start": "0x00E7E8",
      "end": "0x00E7FC",
      "callers_count": 34,
      "notes": "Plays spatial sound at entity position (+$8, +$C) with bit 31 set."
    },
    "spatial_sound_entity_flag_clear": {
      "start": "0x00E7FC",
      "end": "0x00E834",
      "callers_count": 78,
      "notes": "Plays spatial sound at entity position (+$8, +$C) with bit 31 clear."
    },
    "spatial_audio_distance_attenuation_and_pan": {
      "start": "0x00E834",
      "end": "0x00E90E",
      "callers_count": 4,
      "notes": "Calculates isometric distance max(|dx|, 1.25 * |dy|). For ID >= 0x300: near radius 0x58 (no attenuation), 32px step buckets, culls if distance > 312px, applies stereo pan (+0x42 left, +0x82 right) if |dx| >= 0x40. For 0x200 <= ID < 0x300: culls if distance >= 0x110 (272px), stepped volume reduction at 0xB0 and 0xE0, stereo pan (|dx| >= 0x60). Dispatches to sound driver $60004."
    }
  },
