  "routines": [
    {
      "name": "Spirit_PollButtonACommandInput",
      "start": "0x011A4C",
      "end": "0x011B28",
      "size_bytes": 220,
      "instruction_count": 47,
      "description": "Polls Button A ($FF165E & 0x40) unless cutscene/lock flags $FF1982, $FF1983, or $FF19A7 are non-zero. Tracks hold counter $FF199E (0x14 / 20-frame threshold) and 6-frame double-tap countdown $FF19A1, latches $FF165E to $FF19A3 and $FF19FE to $FF19A4 on initial press, suppresses re-triggering with $FF19A0 = 0xFF, and writes command code $FF19A2 (0 = none, 1 = single tap, 2 = double tap, 3 = 20+ frame hold release)."
    },
    {
      "name": "Spirit_TryConsumePlayerSP",
      "start": "0x011B28",
      "end": "0x011B4E",
      "size_bytes": 38,
      "instruction_count": 11,
      "description": "Shared spirit ability SP-cost guard. Reads Ali's SP +$8E(a5), subtracts requested cost d0.w, commits the updated SP and clears Carry (CCR &= ~1) if signed result >= 1, or leaves SP unchanged and sets Carry (CCR |= 1) if signed result < 1, preserving CCR across movem.l (a7)+, d1."
    },
    {
      "name": "AI_Dytto_MasterTickAndSpDrain",
      "start": "0x011B4E",
      "end": "0x011BA0",
      "size_bytes": 82,
      "instruction_count": 21,
      "description": "Dytto master per-frame update entry point. Loads player base a5 = $FF19E8; when sub-entity flag +$A2(a6) != 0 skips directly to state dispatcher $11BA0. Otherwise calls Spirit_PollButtonACommandInput (0x011A4C) and helper 0x00E36E, ticks 45-frame (0x2D) drain timer +$8E(a6) to deduct 1 SP from Ali +$8E(a5) (branching to spirit dismissal $12314 if SP is 0), and toggles low-SP blink bit 1 on +$36(a6) when Ali's SP <= 1 (clearing bit 1 when SP > 1)."
    }
  ],
