  "routines": [
    {
      "name": "AI_Dytto_StateDispatcher",
      "start": "0x011BA0",
      "end": "0x011BCC",
      "size_bytes": 44,
      "instruction_count": 4,
      "description": "Reads state word +$04(a6) (d0 = $00..$1E in steps of 2), loads entry address a1 = 0x011BAC + d0, adds signed 16-bit displacement *(int16*)a1 (self-relative to each table slot address), and jumps to handler.",
      "code_end": "0x011BAC",
      "table_start": "0x011BAC",
      "table_end": "0x011BCC"
    },
    {
      "name": "AI_Dytto_TryStartHealingCast",
      "start": "0x011BCC",
      "end": "0x011BF2",
      "size_bytes": 38,
      "instruction_count": 9,
      "description": "Attempts to start Dytto's healing drop cast: consumes 20 ($14) SP via 0x011B28 (branching to error buzzer 0x01219A on Carry set), plays SFX #$800258 via 0x00E7FC, clears +$16(a6), enters State $18 (+$04=$18), and sets anim/action +$2A=$0E."
    },
    {
      "name": "AI_Dytto_State18_HealingCastAndSpawnOrb",
      "start": "0x011BF2",
      "end": "0x011C7A",
      "size_bytes": 136,
      "instruction_count": 29,
      "description": "On animation frame +$30(a6) == $28 (40), allocates Pool 1 slot via 0x00DA1A, sets Type $18 and calls entity init 0x008D06, sets sprite table #$00141374, priority (+$18(a4) & $8000) | $07A8, +$36=8, +$38=$0D, +$A2=$FF, State $12 (+$2A=$20), copies parent (x,y,z) with +$10 += $20, and clears +$16. When +$30 != $28, returns parent to State 0 (0x0121AA) if +$37 bit 1 is set."
    },
    {
      "name": "AI_Dytto_State12_HealingOrbHomingAndHpRestore",
      "start": "0x011C7A",
      "end": "0x011D7C",
      "size_bytes": 258,
      "instruction_count": 81,
      "description": "Steps +$10(a6) toward +$10(a5)+$20 by clamped [-3..+3] while computing d6 = abs(target_z - z_before_step); homes 2D velocity toward Ali (+$08(a5), +$0C(a5)+6) via 0x00E45E (doubling velocities into +$72/+$76). While d6 > 4 or d4 > 2, spawns sparkle sub-entity (State $14, +$2A=$1C, PRNG jitter [-3..+4]) on even $FF1971 frames via 0x00DA1A+0x00E66E+0x00E268. On arrival (d6 <= 4 and d4 <= 2), despawns orb and restores Ali's HP +$8A(a5) by tier = ($FF0DB6+1)>>2 (0:max>>3, 1:max>>2, 2:max>>1, 3:(max>>1)+(max>>2), 4:max), clamped to +$88(a5) unless $FF1987!=0, and plays #$D00355 via 0x060004."
    },
    {
      "name": "AI_Dytto_State14_HealingSparkleDespawn",
      "start": "0x011D7C",
      "end": "0x011D8A",
      "size_bytes": 14,
      "instruction_count": 4,
      "description": "Despawns healing trail sparkle sub-entity (clr.w +$00(a6)) when animation completion bit 1 of +$37(a6) is set."
    }
  ],
  "instruction_count": 127,
