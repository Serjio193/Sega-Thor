    {
      "name": "BossAI_State10_CombatAttack",
      "start": "0x014A72",
      "end": "0x014ABC",
      "size_bytes": 74,
      "instruction_count": 18,
      "description": "State $10: Decrements timer at +$2; when 0 calls High Orbit helper 0x014C1C. Steers towards target (+$A6, +$AA) via 0x0150A0. If +$30 == $18 and +$2E == 0, calls special projectile spawn 0x015214 and plays SFX #$0080034F via 0x00E7FC. When anim complete (+$37 bit 1 set), sets substate +$2A = 8 and transitions to 0x014958."
    },
    {
      "name": "BossAI_State06_OrbitApproach",
      "start": "0x014ABC",
      "end": "0x014AEA",
      "size_bytes": 46,
      "instruction_count": 11,
      "description": "State $06: Decrements timer at +$2; when 0 calls Low Orbit helper 0x014CA0. Steers towards target (+$A6, +$AA) via 0x0150A0. When anim complete (+$37:1), sets substate +$2A = 0 and transitions to State $08 (+$04 = 8)."
    },
    {
      "name": "BossAI_State08_OrbitCombatAttack",
      "start": "0x014AEA",
      "end": "0x014B50",
      "size_bytes": 102,
      "instruction_count": 25,
      "description": "State $08: Decrements timer at +$2; when 0 calls Low Orbit helper 0x014CA0. Steers via 0x0150A0. When +$32 == 12 and $FF1971 % 3 == 0, calls attack helper 0x015136 and (if quotient & 3 == 0) plays SFX #$0080034F. When anim complete (+$37:1), sets substate +$2A = 4 and transitions to State $0A (+$04 = $0A)."
    },
    {
      "name": "BossAI_State0A_Retreat",
      "start": "0x014B50",
      "end": "0x014B7C",
      "size_bytes": 44,
      "instruction_count": 11,
      "description": "State $0A: Decrements timer at +$2; when 0 calls Low Orbit helper 0x014CA0. Steers via 0x0150A0. When anim complete (+$37:1), sets substate +$2A = 8 and transitions to 0x014958."
    },
    {
      "name": "BossAI_State16_ChaseAliHitbox",
      "start": "0x014B7C",
      "end": "0x014BB8",
      "size_bytes": 60,
      "instruction_count": 13,
      "description": "State $16: Steers directly towards Ali ($FF19E8) via 0x0150A0. Tests attack hitbox $58CE6 via 0x00BAAC. If carry set (hit landed) or timer +$2 expires, transitions to State $18 (+$04 = $18, +$2A = $1A, speed +$B0 = $00010000)."
    },
    {
      "name": "BossAI_State18_HitThrustAndCallback",
      "start": "0x014BB8",
      "end": "0x014C1C",
      "size_bytes": 100,
      "instruction_count": 20,
      "description": "State $18: Steers towards Ali via 0x0150A0. Registers hit callback 0x014C04 at $FF1940 and calls 0x00BCE2. When anim complete (+$37:1), resets state via 0x014958, sets +$2A = 8, speed +$B0 = $00030000, timer +$2 = 20 ($14), and flips angle +$AF += $80. Callback 0x014C04 calls 0x00BEBA and applies knockback $00020000 to Ali +$52.",
