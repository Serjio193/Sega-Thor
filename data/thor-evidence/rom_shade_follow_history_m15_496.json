  "routines": [
    {
      "name": "AI_Shade_State00_IdleCommandAndHistoryFollow",
      "start": "0x01366A",
      "end": "0x0136AC",
      "size_bytes": 66,
      "instruction_count": 15,
      "description": "Propagates +$36(a5) bit 1 -> +$36(a6) bit 1 when set, checks dismissal flag $FF19A7 (-> 0x0136D4), dispatches $FF19A2 command codes (1->0x01301E, 2->0x01319E, 3->0x013134), asserts $FF1989=$FF, and calls 0x0137F0."
    },
    {
      "name": "AI_Shade_State04_HitstunBlinkRecovery",
      "start": "0x0136AC",
      "end": "0x0136CC",
      "size_bytes": 32,
      "instruction_count": 7,
      "description": "Decrements +$83(a6); while non-zero sets +$36(a6) bit 6 (blink). When +$83(a6) hits 0, clears +$36(a6) bit 6 and +$39(a6) bit 3, and exits via 0x01378A into State 0 doppelganger mimic mode."
    },
    {
      "name": "AI_Shade_DismissalAndState10_AscendDespawn",
      "start": "0x0136CC",
      "end": "0x013716",
      "size_bytes": 74,
      "instruction_count": 19,
      "description": "0x0136CC guards +$04(a6)==0 (else 0x012F6A). 0x0136D4 plays SFX #$00A0039E via 0x00E7FC, calls 0x013764 ($03F4A6), clears +$16(a6)=0, sets State $10, and triggers anim $14 via 0x008EF8. State $10 (0x0136F8) clears +$36 bit 1 and ascends +$10(a6) by +8/frame until > $100 (256), then clears +$00(a6)=0.",
      "sub_entry_points": {
        "sp_drain_dismissal_guard": "0x0136CC",
        "start_dismissal": "0x0136D4",
        "state_10_ascend_despawn": "0x0136F8"
      }
    },
    {
      "name": "AI_Shade_State02_SummonApproachHoming",
      "start": "0x013716",
      "end": "0x013764",
      "size_bytes": 78,
      "instruction_count": 23,
      "description": "Promotes +$2A(a6)=$14 once +$37(a6) bit 1 is set, calls 0x0123B8 (d4=1) for elevation tracking, computes Z-compensated Ali target Y (+ +$14(a5) - +$14(a6) when both >= 0) and calls 0x00E45E; if d4 <= 7 enters mimic via 0x01378A, else shifts (d1, d2) left by 2 (4x) into +$72/+$76(a6)."
    },
    {
      "name": "AI_Shade_DescriptorSwitchAndPoseHistoryRing",
      "start": "0x013764",
      "end": "0x01387C",
      "size_bytes": 280,
      "instruction_count": 71,
      "description": "0x013764 loads Shade body descriptor $03F4A6 (+$1A/+$1E/+$26), +$38=$0E, +$2C=$FFFF, +$34=$FFFF. 0x01378A sets State 0, loads doppelganger descriptor $03F306 (+$38=$0D), clears +$06/+$39/+$82/+$83/+$86, invalidates +$34=$FFFF, primes both 12-byte ring slots $FF19A8 and $FF19B4 via 0x01386E, and falls through to 0x0137F0. 0x0137F0 clears +$72/+$76, pops 6 words from $FF19B4 (x,y,z,ground_z,facing,anim) into Shade, locks +$2E=$03DE, clears +$39/+$6E/+$6F, copies 6 words $FF19A8->$FF19B4, and captures current Ali pose (x+vx,y+vy,z,ground_z,facing,anim) into $FF19A8 via 0x01386E.",
      "sub_entry_points": {
        "switch_to_shade_body_desc": "0x013764",
        "enter_doppelganger_mimic_mode": "0x01378A",
        "step_pose_history_ring": "0x0137F0",
        "write_pose_snapshot": "0x01386E"
      }
    }
  ],
