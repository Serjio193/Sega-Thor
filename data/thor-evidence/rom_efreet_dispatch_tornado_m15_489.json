  "routines": [
    {
      "name": "AI_Dytto_WaterTornadoSteeringAndTrigVelocity",
      "start": "0x0123E2",
      "end": "0x01254C",
      "size_bytes": 362,
      "instruction_count": 120,
      "description": "Calls 0x0123AE (8px hover), loads angle +$4E, angular vel +$50, drift timer +$51, speed +$52. Handles +$40 bit 6 X-reflection ((128-ang)&$FF) and +$41 bit 6 Y-reflection ((256-ang)&$FF) with -vel; bounces inside camera [cam_x..cam_x+$140, cam_y..cam_y+$E0] ($FF1716/$FF173E via $FF16F0 bit 7) halving turn rate and setting timer=1. On Button A ($FF165E bit 6), clears $FF199E and steers shortest-arc (max step 8) toward 0x00E706 angle; else ticks 7-frame PRNG drift (+/-4 via 0x00E268). Ramps speed <= $80000 by $2000, maps $20/$60/$A0/$E0 sectors to 4-way +$16, and integrates sin/cos ($05D706) velocity into +$72/+$76."
    },
    {
      "name": "AI_Efreet_MasterTickAndDispatcher",
      "start": "0x01254C",
      "end": "0x0125CA",
      "size_bytes": 126,
      "instruction_count": 26,
      "description": "Sets a5=$FF19E8; bypasses to state dispatcher 0x0125A2 when +$A2!=0. Otherwise calls 0x00E682, 0x011A4C, 0x00E36E, ticks 35-frame ($23) SP drain timer +$8E to deduct 1 SP from +$8E(a5) (dismissing via 0x012BA8 when 0), toggles +$36 bit 1 when SP<=1 (clears when >1), and jumps via 14-entry signed word self-relative table 0x0125AE..0x0125CA ($00..$1A).",
      "code_end": "0x0125AE",
      "table_start": "0x0125AE",
      "table_end": "0x0125CA"
    },
    {
      "name": "AI_Efreet_TryStartDashCharge",
      "start": "0x0125CA",
      "end": "0x012608",
      "size_bytes": 62,
      "instruction_count": 15,
      "description": "Dispatched on $FF19A2==2 (0x0129A0): consumes 8 SP via 0x011B28 (branching to buzzer 0x012978 on Carry set), enters State $08 (+$2A=$0C), copies Ali's facing +$16(a5), resolves directional velocity (0x100,0x100) via 0x00E2D4 into +$4E/+$52, and plays SFX #$800258 via 0x00E7FC.",
      "command_code": 2
    },
    {
      "name": "AI_Efreet_TryStartFlameBreath",
      "start": "0x012608",
      "end": "0x01263C",
      "size_bytes": 52,
      "instruction_count": 12,
      "description": "Dispatched on $FF19A2==1 (0x012998): consumes 6 SP via 0x011B28 (else 0x012978), requires slot $FF1C1C +$00==0 (else 0x012978), reserves +$00=$FFFE and stores $FF1C1C into +$A6(a6), calls 0x012C4E, and enters State $0A (+$2A=2).",
      "command_code": 1
    },
    {
      "name": "AI_Efreet_TryStartFireballMeltdown",
      "start": "0x01263C",
      "end": "0x012672",
      "size_bytes": 54,
      "instruction_count": 12,
      "description": "Dispatched on $FF19A2==3 (0x0129A8): consumes 25 ($19) SP via 0x011B28 (else 0x012978), enters State $0C (+$2A=8), sets facing 2, +$AE=$60 (96), clears +$02, and sets +$AF = $FF0DB7 + $10.",
      "command_code": 3
    },
    {
