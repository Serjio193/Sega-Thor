        "max_words": 16,
        "terminator": "0xFFFF"
      }
    },
    {
      "opcode": "0x03",
      "name": "ScriptOp_SetTargetCoordinatePairTable",
      "start": "0x00F942",
      "end": "0x00F96A",
      "size_bytes": 40,
      "description": "Reads coordinate/target word pairs from script stream into $FF17E6 (up to 16 pairs / 32 bytes). If $FFFF is encountered, fills remaining pairs with $FFFF.",
      "constants": {
        "dest_buffer": "0xFF17E6",
        "max_pairs": 16,
        "terminator": "0xFFFF"
      }
    },
    {
      "opcode": "0x04",
      "name": "ScriptOp_WaitUntilCondition",
      "start": "0x00F96A",
      "end": "0x00FAAC",
      "size_bytes": 322,
      "description": "Reads variable selector d0.b, comparison operator d1.b, and compare value / bit index d2.w. Resolves variable value: d0=0 calls $0101EC (quest var), d0=1..3 tests bit d2 in persistent bitmask banks $FF0DBC / $FF0E1C / $FF0E2C (with polarity d1), d0=4/5 reads Ali X ($FF19F0) / Y ($FF19F4), d0=6/7 reads Spirit X ($FF1AAC) / Y ($FF1AB0) when active ($FF1AA4 == $1A). Evaluates relational comparison (==, !=, >, >=, <=, <). If true, exits handler to advance script; if false, yields frame via $F91C so condition is re-evaluated next frame.",
      "constants": {
        "bank1_bits": "0xFF0DBC",
        "bank2_bits": "0xFF0E1C",
        "bank3_bits": "0xFF0E2C",
        "ali_x": "0xFF19F0",
        "ali_y": "0xFF19F4",
        "spirit_type": "0x001A",
        "spirit_status": "0xFF1AA4",
        "spirit_x": "0xFF1AAC",
        "spirit_y": "0xFF1AB0"
      }
    }
  ],
