  "routines": [
    {
      "name": "BossAI_State1A_DeathCutsceneSequence",
      "start": "0x014F60",
      "end": "0x01503C",
      "size_bytes": 220,
      "instruction_count": 46,
      "description": "State $1A death cutscene sequencer: increments timer +$2; at frame $B4 (180) clears $FF164F, sets $FF1896=6, calls palette effect 0x002E78 and shake helper 0x01503C; during frames < $F0 (240) invokes shake 0x01503C; at frame $12C (300) clears 17 Pool 2 slots ($FF1D94..), streams Nemesis art $167C54 via 0x00D9A4 into $8F00, spawns item Type $56 at $FF2D8C (tile $478, coords (0x100, 0x98), z-vel $10000, z-acc $331DC); at frame $168 (360) clears $FF1983, sets $FF1896=4, calls 0x002DB6 and 0x00DAC2 with d0=$11F, sets $FF1D0E:1 and $FF0DC3:2; at frame $1A4 (420) sets $FF164F=$FF and despawns boss slot $FF1CD8."
    },
    {
      "name": "BossAI_DeathExplosionShake",
      "start": "0x01503C",
      "end": "0x0150A0",
      "size_bytes": 100,
      "instruction_count": 26,
      "description": "Spawns death explosion particle type 1 via 0x00E90E at (0x100 - plane_b_x + plane_a_x + prng>>1, 0x00E8 - plane_b_y + plane_a_y + prng>>1 + $E0). Updates screen shake at $FF17C4 to oscillate between 2 and 3 based on frame counter ($FF1971 & 1) + 2."
    },
    {
      "name": "BossAI_SmoothAngleSteering",
      "start": "0x0150A0",
      "end": "0x015136",
      "size_bytes": 150,
      "instruction_count": 49,
      "description": "Smooth angle turn-rate limiter and sin/cos velocity integrator: calls 0x00E6F0 for target angle, clamps angular turn step to <= 8 units into +$AE. Computes X/Y velocities via sin/cos table $5D706 with scaled speed +$B0>>7, storing into +$4E/+$52 and integrating +$72/+$76. Updates facing +$16 relative to Ali ($FF19E8) X: < $A0 -> 3 (left), < $160 -> 2 (down), >= $160 -> 1 (right)."
    }
  ],
