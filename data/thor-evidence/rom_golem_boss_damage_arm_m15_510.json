  "routines": [
    {
      "name": "AI_GolemBoss_BodyHitDamage",
      "start": "0x015758",
      "end": "0x0157FC",
      "size_bytes": 164,
      "description": "Golem Body Hit Damage & Phase 1 Fracture. Checks pending damage +$86(a6); bypasses to tentacle arm 0x01585C if 0 or if already in hitstun state 4. Subtracts 12-bit masked damage from HP +$8A; triggers death routine 0x00E96C (d0=7) on HP=0. Otherwise enters State 4 (anim 6, hitstun timer 8). If phase +$8E == 1 and HP <= max_hp / 4, increments +$8E to 2, emits debris particle 3 at (x-136, y-64, z), and applies Plane A tilemap fracture patch 1 via 0x00DB68."
    },
    {
      "name": "TilemapPatch_Phase1",
      "start": "0x0157FC",
      "end": "0x015808",
      "size_bytes": 12,
      "description": "Embedded 12-byte Plane A tilemap patch record for Phase 1 fracture: rect [6, 32, 11, 37] -> [33, 12]."
    },
    {
      "name": "AI_GolemBoss_Phase0Check",
      "start": "0x015808",
      "end": "0x015850",
      "size_bytes": 72,
      "description": "Phase 0 fracture check. If +$8E == 0 and HP <= max_hp / 2, increments +$8E to 1, sets bit 1 in $FF2A3E, emits debris particle 3 at (x-128, y+8, z), and applies Plane A tilemap fracture patch 0 via 0x00DB68."
    },
    {
      "name": "TilemapPatch_Phase0",
      "start": "0x015850",
      "end": "0x01585C",
      "size_bytes": 12,
      "description": "Embedded 12-byte Plane A tilemap patch record for Phase 0 fracture: rect [0, 32, 5, 37] -> [32, 17]."
    },
    {
      "name": "AI_GolemBoss_TentacleArm_Dispatcher",
      "start": "0x01585C",
      "end": "0x015882",
      "size_bytes": 38,
      "description": "Tentacle arm sub-state dispatcher: dispatches on +$04 to States 0..4 (0=idle, 1=extend, 2=retract, 3=cooldown, 4=hitstun)."
    },
    {
      "name": "AI_GolemBoss_TentacleArm_State01_Extend",
      "start": "0x015882",
      "end": "0x015932",
      "size_bytes": 176,
      "description": "State 1 Extend / Attack. Decrements timer +$2; transitions to State 2 on expiration. Steers toward Ali ($FF19F0/$FF19F4) via 0x00E45E at 2x speed. When distance d4 <= 4, checks Ali guard (+$38:3, +$82); if vulnerable, inflicts 10 damage (+bit 15 if airborne), knockback vx=-$50000, vz=+$20000, hitstun timer 14, plays SFX $800381, and enters State 3 cooldown (8f)."
    },
    {
      "name": "AI_GolemBoss_TentacleArm_State03_Cooldown",
      "start": "0x015932",
      "end": "0x015940",
      "size_bytes": 14,
      "description": "State 3 Post-attack cooldown. Decrements timer +$2; transitions to State 2 (retract) upon expiration."
    },
    {
      "name": "AI_GolemBoss_TentacleArm_State02_Retract",
      "start": "0x015940",
      "end": "0x01596C",
      "size_bytes": 44,
      "description": "State 2 Retract toward home ($FF1CE0/$FF1CE4) via 0x00E45E at 2x speed. When distance d4 <= 4, resets arm to State 0 (idle)."
    },
    {
      "name": "AI_GolemBoss_TentacleArm_State04_Hitstun",
      "start": "0x01596C",
      "end": "0x0159B4",
      "size_bytes": 72,
      "description": "State 4 Hitstun retract. Decrements hitstun timer +$83. While active, sets flashing bit +$36:6 and retracts toward home at 1x speed (clamping when d4 <= 2). On expiration, clears +$36:6 and +$39:3, transitioning to State 2 (retract)."
    },
    {
      "name": "AI_GolemBoss_SporeHomingReturn",
      "start": "0x0159B4",
      "end": "0x0159E2",
      "size_bytes": 46,
      "description": "Spore homing return sub-mode (+A2 == 3). Reads parent entity pointer +$A6(a6); steers toward parent pos via 0x00E45E at 4x speed. Despawns spore (+0=0) when distance d4 <= 10."
    }
  ]
