    {
      "name": "AI_SerpentBoss_Phase1BodyContactAABB",
      "start": "0x016764",
      "end": "0x0167BE",
      "size_bytes": 90,
      "instruction_count": 22,
      "description": "Phase 1 Body Contact AABB & Ali Knockback: checks collision box [-$40..+$40, -+$44..+$44] via 0x00B852; on non-immune Ali inflicts damage $8014 (20 HP), hitstun 5, vy=+$40000 (+4.0 px), vz=-1, attacker ptr a6."
    },
    {
      "name": "AI_SerpentBoss_Phase1HomingOrbSpawner",
      "start": "0x0167BE",
      "end": "0x01685A",
      "size_bytes": 156,
      "instruction_count": 31,
      "description": "Phase 1 Homing Orb Spawner: allocates Pool 2 slot via $DA2A+$E66E; initializes State $12, tile $200, bounds 8x8x16, spawn pos (x-1, y+16), angle +$7A=d1, speed +$56=d2, anim $16, lifetime (prng&7)+$A1, vy=+$20000, SFX #$70035C."
    },
    {
      "name": "AI_SerpentBoss_Phase1ActionSelector",
      "start": "0x01685A",
      "end": "0x016A46",
      "size_bytes": 492,
      "instruction_count": 110,
      "description": "Phase 1 Action Selector: broadcasts anim $28 via 0x016A46; checks lock $FF1987; evaluates Ali distance via 0x00E398: if d4<24 and d3>=32 enters State 2 Glide (limb anims $20/$1A/$1E/$1C or reversed, SFX #$70021A); else if d2>=0 rolls 0..99: 0..29 Fan Barrage (State $12, anim $C), 30..59 Arm Grab (State $0A, aim velocity to Ali, SFX #$700219), 60..79 State $04, 80..89 Dive Leap (State $0C, SFX #$700219), 90..99 State 0 Idle."
    },
    {
      "name": "AI_SerpentBoss_4LimbAnimBroadcaster",
      "start": "0x016A46",
      "end": "0x016A64",
      "size_bytes": 30,
      "instruction_count": 10,
      "description": "4-Limb Animation Broadcaster: writes anim ID in d0 to +$2A across 4 sequential $BC-strided child slots."
    }
  ],
