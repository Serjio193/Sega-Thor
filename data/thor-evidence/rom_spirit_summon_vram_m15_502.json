  "routines": [
    {
      "name": "Spirits_DecompressAndQueueVramGfx",
      "start": "0x014522",
      "end": "0x014628",
      "size_bytes": 262,
      "instruction_count": 56,
      "description": "Reads spirit entity type from $FF1AA4 and dispatches to decompress sprite graphics via 0x003820 into $FF2FA8, then queues an 8-byte VDP DMA descriptor ($007F97D4, $F500, vram_tile) at $FF1892 under SR |= $0700: Dytto 0x0018 ($141580 -> $04D0), Efreet 0x001A ($1425AE -> $0450), Shade 0x001C ($143262 -> $0280), Bow 0x001E ($143A42 -> $0360)."
    },
    {
      "name": "Spirits_ClearOverlayStateAndDispatch",
      "start": "0x014628",
      "end": "0x014658",
      "size_bytes": 48,
      "instruction_count": 12,
      "description": "Clears $FF199E (hold counter) and $FF19A1 (double-tap timer), sets $FF19A0 = $FF (button A suppression sentinel), and dispatches on $FF19A6 (0 = Dytto 0x014658, 1 = Efreet 0x0146C0, 2 = Shade 0x014732, 3 = Bow 0x014798; >= 4 returns)."
    },
    {
      "name": "Spirits_SpawnDytto",
      "start": "0x014658",
      "end": "0x0146C0",
      "size_bytes": 104,
      "instruction_count": 21,
      "description": "Initializes Dytto (type 0x0018) via 0x008D06, sets +$16=2, +$18=$04F8, +$88=+$8A=100, +$8C=+$8E=10, preserves coordinates (+$08, +$0C, +$10, +$14), sets State $02 (+$04=2, +$2A=4), calls 0x014522, and clears spawn lock $FF19A7."
    },
    {
      "name": "Spirits_SpawnEfreet",
      "start": "0x0146C0",
      "end": "0x014732",
      "size_bytes": 114,
      "instruction_count": 23,
      "description": "Initializes Efreet (type 0x001A) with Z offset +$00080000 via 0x008D06, sets +$18=$04F8, +$88=+$8A=100, +$8C=+$8E=10, preserves XY/Z/ground_z, sets State $04 (+$04=4, +$2A=4, +$16=2, +$A6=a6), calls 0x014522, and clears $FF19A7."
    },
    {
      "name": "Spirits_SpawnShade",
      "start": "0x014732",
      "end": "0x014798",
      "size_bytes": 102,
      "instruction_count": 21,
      "description": "Initializes Shade (type 0x001C) via 0x008D06, sets +$18=$04F8, +$88=+$8A=100, +$8C=+$8E=10, preserves coordinates (+$08, +$0C, +$10, +$14), sets State $02 (+$04=2, +$2A=0, +$16=0), calls 0x014522, and clears spawn lock $FF19A7."
    },
    {
      "name": "Spirits_SpawnBow",
      "start": "0x014798",
      "end": "0x0147E0",
      "size_bytes": 72,
      "instruction_count": 15,
      "description": "Sets entity type +$00=0x001E, calls 0x014522, invokes bow root emerge sub-entity at 0x0147E0 with XYZ coords, sets State $0E (+$04=$0E, +$2A=$1E, +$16=0, +$18=$07A8, +$36:0=0), plays SFX #$0080039F via 0x00E7FC, and clears spawn lock $FF19A7."
    }
  ],
