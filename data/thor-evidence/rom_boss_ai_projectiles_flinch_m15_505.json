{
  "milestone": "M15.505",
  "title": "ROM Boss AI Projectile States $0C/$14/$12, Hit Callbacks & State $0E Hit-Reaction Deceleration",
  "range": {
    "start": "0x014D1A",
    "end": "0x014F60",
    "size_bytes": 582
  },
  "routines": [
    {
      "name": "AI_Boss_State0C_FeatherSporeProjectile",
      "start": "0x014D1A",
      "end": "0x014DA0",
      "size_bytes": 134,
      "description": "State $0C Boss feather/spore projectile. Counts down timer +$2(a6); on expiration runs 0x00B922 AABB vs Ali with bounds [-16..+16, -16..+16, -8..+16], calling hit callback 0x014DA0 on contact. Integrates position into +$72/+$76, accelerates vertical velocity +$56 by +$6000 into +$10. Evaluates life timer +$30(a6) against thresholds <=4, <=16, <=28 to scale size byte +$3D(a6) to 8, 16, 24, setting blink flag +$36:3 at end of life. Despawns slot +$00=0 when animation completes (+0x37:1 set)."
    },
    {
      "name": "AI_Boss_HitCallback_FeatherSpore",
      "start": "0x014DA0",
      "end": "0x014E0C",
      "size_bytes": 108,
      "description": "Hit callback for feather/spore projectile against Ali (a0). Bypasses if Ali is invulnerable (+0x38:3). Assigns attacker pointer +$7E(a0)=a6, damage $200C (ground) or $A00C (airborne), hitstun 6 frames in +$83, knockback mode 2 in +$84, dispatches SFX #$700345 via 0x00E7FC. Copies XY velocities, sets Z velocity $28000 if airborne, asserts Ali hurt state $FF198E=$0E and invulnerability +$38:3, sets projectile cooldown 10."
    },
    {
      "name": "AI_Boss_State14_ProjectileFadeout",
      "start": "0x014E0C",
      "end": "0x014E1A",
      "size_bytes": 14,
      "description": "State $14 projectile/flame impact fadeout. Tests animation completion flag bit 1 of +$37(a6); upon completion, clears entity slot +$00(a6)=0 to despawn."
    },
    {
      "name": "AI_Boss_State12_FireballProjectile",
      "start": "0x014E1A",
      "end": "0x014E86",
      "size_bytes": 108,
      "description": "State $12 Boss fireball projectile. Transitions to State $14 impact fadeout (+0x2A=$16, +0x04=$14) if incoming damage +$86 is received or wall collision (+0x40|+0x41 bit 6) occurs. Runs 0x00B922 AABB vs Ali with bounds [-6..+6, -6..+6, -4..+6], invoking hit callback 0x014E86 before entering fadeout. Integrates XYZ position, clamping Z >= 0 upon floor contact."
    },
    {
      "name": "AI_Boss_HitCallback_Fireball",
      "start": "0x014E86",
      "end": "0x014EE6",
      "size_bytes": 96,
      "description": "Hit callback for fireball projectile against Ali (a0). Assigns attacker pointer +$7E(a0)=a6, damage $2008 (ground) or $A008 (airborne), hitstun 8 frames in +$83, computes knockback facing via 0x00E338 into +$84, plays SFX #$700345 via 0x00E7FC. Copies XY velocities and sets airborne vertical launch impulse $28000."
    },
    {
      "name": "AI_Boss_State0E_HitReactionDecel",
      "start": "0x014EE6",
      "end": "0x014F60",
      "size_bytes": 122,
      "description": "State $0E Boss hit-reaction deceleration and counter-attack switch. Asserts flinch flag +$36:6. Applies friction step $8000 per frame to XY velocities toward zero, integrates position into +$72/+$76. Decelerates vertical velocity +$56 by -$A000 until <= 0. Once airborne arc ends and residual XY velocity is stopped ((d1|d2) & $FFFFF000 == 0), clears flinch flag +$36:6 and evaluates hit counter +$B6: every 4th hit ((+$B6 & 3) == 0) counter-attacks via 0x0149FE (State 8), otherwise transitions via 0x014A22 (State $10). Maintains invulnerability +$38:3 while moving."
    }
  ],
