  "routines": [
    {
      "name": "AI_SerpentBoss_HomingOrb_Tick",
      "start": "0x0160E2",
      "end": "0x016168",
      "size_bytes": 134,
      "instruction_count": 38,
      "description": "State $12 Homing Orb Projectile main loop: cancels/fadeouts on damage, lifetime expiry (+$A1), anim end (+$37:1), or wall contact; tests AABB vs Ali [-4..+4] after age >= 12; calls steering."
    },
    {
      "name": "AI_SerpentBoss_SubStepAnchorIntegrator",
      "start": "0x016168",
      "end": "0x016184",
      "size_bytes": 28,
      "instruction_count": 8,
      "description": "Sub-Step Anchor Integrator: decrements timer +$2; accumulates +$A6/+$AA deltas into +$72/+$76, clears Zero flag in CCR."
    },
    {
      "name": "AI_SerpentBoss_AliGrabPinning",
      "start": "0x016184",
      "end": "0x0161A2",
      "size_bytes": 30,
      "instruction_count": 6,
      "description": "Ali Grab Pinning: copies boss 32-bit XYZ to Ali $FF19E8 with Y offset of -8px (pins Ali in mouth/jaw)."
    },
    {
      "name": "AI_SerpentBoss_HomingOrb_HitCallback",
      "start": "0x0161A2",
      "end": "0x0161FA",
      "size_bytes": 88,
      "instruction_count": 17,
      "description": "Homing Hit Callback: checks Ali invulnerability (+$38:3); applies attacker ptr, hitstun 8, reaction mode from orb facing +$7C, SFX $800216, copies XY velocity, applies damage (2 grounded, $8002+vz=$10000 airborne), zeroes orb velocities and triggers fadeout."
    },
    {
      "name": "AI_SerpentBoss_SmoothHomingTurnRateSteering",
      "start": "0x0161FA",
      "end": "0x016294",
      "size_bytes": 154,
      "instruction_count": 55,
      "description": "Smooth Homing Turn-Rate Limiter & Vector Stepper: clamps turn-rate <= 8 units/frame toward Ali (skipped when speed == $30000); quantizes angle into 4-way facing +$7C; computes sin/cos from $5D706 scaled by speed >> 7; integrates into pos +$72/+$76 and vel +$4E/+$52."
    }
  ],
