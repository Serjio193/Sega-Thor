  "routines": [
    {
      "name": "AI_World_SlidingRetractingWallBridgeTrap",
      "start": "0x0171C4",
      "end": "0x0172C2",
      "size_bytes": 254,
      "instruction_count": 67,
      "description": "Sliding/Retracting Wall or Bridge Trap: sub-mode 0 initializes timer +$2=+$A0, z=+$8C, anchor x=+$A6, offset +$AA=0; sub-mode 1 restores x=+$A6, decrements offset +$AA by 8 until 0, applies directional offset based on facing +$16==1, counts timer +$2, checks persistent bit via 0x018030 (if clear transitions to sub-mode 2, sets timer +$2=+$9E, plays SFX #$700391 via 0x00E7E8); sub-mode 2 sets +$37:3, increments offset +$AA by 8 up to $28 while clearing +$37:3, applies directional offset, animates via 0x00BC8E, checks persistent bit via 0x018030 / timer +$2 to transition back to sub-mode 1 with timer +$2=+$A0."
    },
    {
      "name": "AI_World_FallingRockBoulderTrap",
      "start": "0x0172C2",
      "end": "0x017344",
      "size_bytes": 130,
      "instruction_count": 32,
      "description": "Falling Rock / Boulder Trap: sub-mode 0 initializes +$66=$FF, z=+$8C, sets aerial flag +$38:6; active tick: if z != 0 calls impact AABB 0x017344, applies gravity -$C000 to vz (+$56), integrates z; on floor impact (z < 0) clamps z=0, first bounce (+$A6==0) sets +$A6=$FF, z=1, bounce vz=+$30000, triggers screen shake $FF17C4=3 and rock impact SFX #$800386 via 0x00E7FC; second landing clears vz=0; when z==0 increments fade timer +$2E unless anchor deltas +$72|+$76 != 0."
    },
    {
      "name": "AI_World_FallingRockImpactAABB",
      "start": "0x017344",
      "end": "0x0173D6",
      "size_bytes": 146,
      "instruction_count": 38,
      "description": "Falling Rock / Hazard Impact AABB: tests contact vs Ali via 0x00B922 [-10..+10, -10..+10, 0..24]; if Ali is guarded (+$38:3) or invulnerable (+$82!=0) ignores hit; on vulnerable Ali sets attacker ptr +$7E=a6, damage $8007 (7 HP), clears +$82, +$83, +$9D, imparts launch vz=+$20000, raises z+=1, flips direction bit 1 (+$16^2 -> +$84), computes directional knockback via 0x00E2D4 ($310/$300); plays SFX #$900237 via 0x00E7FC if Ali type==2, else #$800346 via 0x00E7E8."
    }
  ],
