+		public uint LiveForwardExportRecords(string path, uint workerId,
+			ulong generation, uint recordCount, bool append)
+		{
+			const uint pageCapacity = 512;
+			var records = new LibGPGX.LiveForwardRecord[pageCapacity];
+			using var stream = new FileStream(path,
+				append ? FileMode.Append : FileMode.Create, FileAccess.Write,
+				FileShare.ReadWrite);
+			for (uint offset = 0; offset < recordCount;)
+			{
+				uint capacity = Math.Min(pageCapacity, recordCount - offset);
+				uint copied = Core.gpgx_live_forward_result_copy(workerId,
+					generation, offset, records, capacity);
+				if (copied != capacity) return offset;
+				stream.Write(MemoryMarshal.AsBytes(records.AsSpan(0, (int)copied)));
+				offset += copied;
+			}
+			return recordCount;
+		}
+
 		public int LiveForwardAck(uint workerId, ulong captureId, ulong generation,
