diff --git a/waterbox/gpgx/cinterface/live_forward_api.c b/waterbox/gpgx/cinterface/live_forward_api.c
new file mode 100644
index 0000000..7ddd4a0
--- /dev/null
+++ b/waterbox/gpgx/cinterface/live_forward_api.c
@@ -0,0 +1,107 @@
+#include <stdint.h>
+#include <emulibc.h>
+#include <debug/live_forward_trace.h>
+
+#define GPGX_EX ECL_EXPORT
+
+GPGX_EX int gpgx_live_forward_configure(uint32_t worker_count, uint32_t depth,
+	uint32_t memory_bytes)
+{
+	return oasis_lf_configure(worker_count, depth, memory_bytes);
+}
+
+GPGX_EX int gpgx_live_forward_set_enabled(uint32_t enabled)
+{
+	return oasis_lf_set_enabled(enabled);
+}
+
+GPGX_EX int gpgx_live_forward_request(uint32_t worker_id, uint64_t capture_id,
+	uint64_t generation, uint64_t run_id, uint64_t epoch)
+{
+	return oasis_lf_request(worker_id, capture_id, generation, run_id, epoch);
+}
+
+GPGX_EX uint32_t gpgx_live_forward_worker_state(uint32_t worker_id)
+{
+	return oasis_lf_result_state(worker_id);
+}
+
+GPGX_EX uint64_t gpgx_live_forward_epoch(void)
+{
+	return oasis_lf_epoch();
+}
+
+GPGX_EX uint64_t gpgx_live_forward_stream_sequence(void)
+{
+	return oasis_lf_stream_sequence();
+}
+
+GPGX_EX uint64_t gpgx_live_forward_instruction_sequence(void)
+{
+	return oasis_lf_instruction_sequence();
+}
+
+GPGX_EX void gpgx_live_forward_epoch_break(void)
+{
+	oasis_lf_epoch_break(0);
+}
+
+GPGX_EX uint32_t gpgx_live_forward_result_info(uint32_t worker_id,
+	uint64_t *output, uint32_t capacity)
+{
+	oasis_lf_result result;
+	if (!output || capacity < 20 || !oasis_lf_result_info(worker_id, &result))
+		return 0;
+	output[0] = result.capture_id;
+	output[1] = result.generation;
+	output[2] = result.run_id;
+	output[3] = result.epoch;
+	output[4] = result.entry_stream_sequence;
+	output[5] = result.exit_stream_sequence;
+	output[6] = result.entry_instruction_sequence;
+	output[7] = result.exit_instruction_sequence;
+	output[8] = result.entry_control_flow_sequence;
+	output[9] = result.exit_control_flow_sequence;
+	output[10] = result.worker_id;
+	output[11] = result.termination_reason;
+	output[12] = result.configured_depth;
+	output[13] = result.configured_memory_bytes;
+	output[14] = result.consumed_depth;
+	output[15] = result.consumed_memory_bytes;
+	output[16] = result.record_count;
+	output[17] = result.records_bytes;
+	output[18] = result.valid;
+	output[19] = result.copy_duration_ns;
+	return 20;
+}
+
+GPGX_EX uint32_t gpgx_live_forward_result_cpu_state(uint32_t worker_id,
+	uint32_t exit_state, uint32_t *output, uint32_t capacity)
+{
+	oasis_lf_result result;
+	uint32_t i;
+	if (!output || capacity < 20 || !oasis_lf_result_info(worker_id, &result))
+		return 0;
+	for (i = 0; i < 8; ++i)
+		output[i] = exit_state ? result.exit_state.d[i] : result.entry_state.d[i];
+	for (i = 0; i < 8; ++i)
+		output[i + 8] = exit_state ? result.exit_state.a[i] : result.entry_state.a[i];
+	output[16] = exit_state ? result.exit_state.pc : result.entry_state.pc;
+	output[17] = exit_state ? result.exit_state.sr : result.entry_state.sr;
+	output[18] = exit_state ? result.exit_state.usp : result.entry_state.usp;
+	output[19] = exit_state ? result.exit_state.isp : result.entry_state.isp;
+	return 20;
+}
+
+GPGX_EX uint32_t gpgx_live_forward_result_copy(uint32_t worker_id,
+	uint64_t generation, uint32_t offset, oasis_lf_record *output,
+	uint32_t capacity)
+{
+	return oasis_lf_result_copy(worker_id, generation, offset, output, capacity);
+}
+
+GPGX_EX int gpgx_live_forward_ack(uint32_t worker_id, uint64_t capture_id,
+	uint64_t generation, uint64_t run_id, uint64_t epoch)
+{
+	return oasis_lf_ack(worker_id, capture_id, generation, run_id, epoch);
+}
