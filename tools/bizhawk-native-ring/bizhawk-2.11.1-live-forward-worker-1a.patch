@@ -0,0 +1,65 @@
+namespace BizHawk.Emulation.Cores.Consoles.Sega.gpgx
+{
+	public partial class GPGX
+	{
+		public int LiveForwardConfigure(uint workerCount, uint depth, uint memoryBytes)
+			=> Core.gpgx_live_forward_configure(workerCount, depth, memoryBytes);
+
+		public int LiveForwardSetEnabled(bool enabled)
+			=> Core.gpgx_live_forward_set_enabled(enabled ? 1u : 0u);
+
+		public int LiveForwardRequest(uint workerId, ulong captureId,
+			ulong generation, ulong runId, ulong epoch)
+			=> Core.gpgx_live_forward_request(workerId, captureId, generation, runId, epoch);
+
+		public uint LiveForwardWorkerState(uint workerId)
+			=> Core.gpgx_live_forward_worker_state(workerId);
+
+		public ulong LiveForwardEpoch()
+			=> Core.gpgx_live_forward_epoch();
+
+		public ulong LiveForwardStreamSequence()
+			=> Core.gpgx_live_forward_stream_sequence();
+
+		public ulong LiveForwardInstructionSequence()
+			=> Core.gpgx_live_forward_instruction_sequence();
+
+		public void LiveForwardEpochBreak()
+			=> Core.gpgx_live_forward_epoch_break();
+
+		public ulong[] LiveForwardResultInfo(uint workerId)
+		{
+			var result = new ulong[20];
+			return Core.gpgx_live_forward_result_info(workerId, result, (uint)result.Length) == result.Length
+				? result
+				: Array.Empty<ulong>();
+		}
+
+		public uint[] LiveForwardResultCpuState(uint workerId, bool exitState)
+		{
+			var result = new uint[20];
+			return Core.gpgx_live_forward_result_cpu_state(workerId, exitState ? 1u : 0u,
+				result, (uint)result.Length) == result.Length
+				? result
+				: Array.Empty<uint>();
+		}
+
+		public LibGPGX.LiveForwardRecord[] LiveForwardResultCopy(uint workerId,
+			ulong generation, uint offset, uint capacity)
+		{
+			if (capacity == 0 || capacity > 8192)
+				return Array.Empty<LibGPGX.LiveForwardRecord>();
+			var result = new LibGPGX.LiveForwardRecord[(int)capacity];
+			uint copied = Core.gpgx_live_forward_result_copy(workerId, generation,
+				offset, result, capacity);
+			if (copied > result.Length) return Array.Empty<LibGPGX.LiveForwardRecord>();
+			Array.Resize(ref result, (int)copied);
+			return result;
+		}
+
+		public int LiveForwardAck(uint workerId, ulong captureId, ulong generation,
+			ulong runId, ulong epoch)
+			=> Core.gpgx_live_forward_ack(workerId, captureId, generation,
+				runId, epoch);
+	}
+}
