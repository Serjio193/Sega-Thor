diff --git a/core/debug/live_forward_bus.c b/core/debug/live_forward_bus.c
new file mode 100644
index 0000000..bc395eb
--- /dev/null
+++ b/core/debug/live_forward_bus.c
@@ -0,0 +1,43 @@
+#include <stdint.h>
+
+#include "../shared.h"
+#include "live_forward_trace.h"
+
+static int is_vdp_map(const cpu_memory_map *map)
+{
+  return map->read8 == vdp_read_byte || map->read16 == vdp_read_word ||
+    map->write8 == vdp_write_byte || map->write16 == vdp_write_word;
+}
+
+static int is_z80_map(const cpu_memory_map *map)
+{
+  return map->read8 == z80_read_byte || map->read16 == z80_read_word ||
+    map->write8 == z80_write_byte || map->write16 == z80_write_word;
+}
+
+uint16_t oasis_lf_resolve_domain(const void *opaque_map, uint32_t address)
+{
+  const cpu_memory_map *map = (const cpu_memory_map *)opaque_map;
+  uintptr_t base = (uintptr_t)map->base;
+  uintptr_t ram = (uintptr_t)work_ram;
+  uintptr_t boot = (uintptr_t)boot_rom;
+  uintptr_t rom = (uintptr_t)cart.rom;
+
+  if (is_vdp_map(map))
+  {
+    uint32_t port = address & 0x1fu;
+    if (port == 0x10u || port == 0x14u)
+      return OASIS_LF_BUS_PSG;
+    return OASIS_LF_BUS_VDP;
+  }
+  if (is_z80_map(map))
+    return ((address >> 13u) & 3u) == 2u ?
+      OASIS_LF_BUS_YM2612 : OASIS_LF_BUS_Z80_WINDOW;
+  if (base >= ram && base < ram + sizeof(work_ram))
+    return OASIS_LF_BUS_68K_RAM;
+  if (base >= boot && base < boot + sizeof(boot_rom))
+    return OASIS_LF_BUS_ROM;
+  if (base >= rom && base < rom + MAXROMSIZE)
+    return OASIS_LF_BUS_ROM;
+  return OASIS_LF_BUS_OTHER;
+}
