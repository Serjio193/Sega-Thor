+		[LuaMethod("freeze_native_trace_snapshot", "Synchronously copies the experimental native GPGX trace ring.")]
+		public string FreezeNativeTraceSnapshot(int epoch, int occurrenceSequence)
+		{
+			if (Emulator is not GPGX gpgx)
